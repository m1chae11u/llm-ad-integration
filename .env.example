DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_openai_api_key_here
HF_TOKEN=your-HF-token

# PPO training (memory-related; reduce if you hit OOM)
# Per-device batch size (default 4). Try 2 or 1 to reduce memory.
# PPO_BATCH_SIZE=2
# Max new tokens per generation (default 256 with GPU). Lower to save memory.
# MAX_NEW_TOKENS=128
# Smaller model: e.g. meta-llama/Llama-3.2-1B-Instruct or TinyLlama/TinyLlama-1.1B-Chat-v1.0
# BASE_MODEL=meta-llama/Llama-3.1-8B
# 8-bit quantization for policy (~50% less weight memory). Set to true if OOM.
# USE_8BIT=false
# Gradient accumulation: effective batch = PPO_BATCH_SIZE * PPO_GRADIENT_ACCUMULATION_STEPS (default 1).
# PPO_GRADIENT_ACCUMULATION_STEPS=1
# Forward-pass mini-batch size; reduces peak activation memory (default 2).
# PPO_MINI_BATCH_SIZE=2
# PPO_EPOCHS=2

# LoRA config (USE_LORA=true is strongly recommended for 8B models to avoid OOM)
# Disabling LoRA means all 8B params are trainable -> ~64GB optimizer states -> OOM.
# USE_LORA=true
# LORA_R=16
# LORA_ALPHA=32
# LORA_DROPOUT=0.05
# Comma-separated attention projection layers to apply LoRA to.
# Add k_proj,o_proj,gate_proj,up_proj,down_proj for higher rank coverage.
# LORA_TARGET_MODULES=q_proj,v_proj